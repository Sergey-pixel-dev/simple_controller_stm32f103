{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/modbus_stm32f103.elf",
            "servertype": "openocd",
            "device": "STM32F103C8", // Ваш MCU
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/STM32F103.svd",
            "serverArgs": [],
            "searchDir": [
                "/usr/share/openocd/scripts"
            ],
            "gdbPath": "/home/serg50012/stm/CubeCTL/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "objdumpPath": "/home/serg50012/stm/CubeCTL/GNU-tools-for-STM32/bin/arm-none-eabi-objdump",
            "nmPath": "/home/serg50012/stm/CubeCTL/GNU-tools-for-STM32/bin/arm-none-eabi-nm",
            "postRestartCommands": [
                "break main",
                "continue"
            ],
            "showDevDebugOutput": "raw"
        }
    ]
}